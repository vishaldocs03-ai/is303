while user_guess != secret_number:
    
    if user_guess > 100 or user_guess < 1:
        print("Invalid guess, please try again!")

    while user_guess != secret_number:
        if user_guess < secret_number:
                number_of_guesses += 1
                print("Higher!")
        elif user_guess > secret_number:
                    number_of_guesses += 1
                    print("Lower!")

    if user_guess == secret_number:
        if number_of_guesses <= 3:
            print("Amazing!")
        elif number_of_guesses == 4 or number_of_guesses == 5:
            print("Impressive!")
        elif number_of_guesses == 6 or number_of_guesses == 7:
            print("Good job!")
        elif number_of_guesses == 8 or number_of_guesses == 9:
            print("Took a little longer, but you got there!")
        elif number_of_guesses >= 10:
